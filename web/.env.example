# Keep this on the server. Do not paste a token into the browser.
GITHUB_TOKEN=
PORT=5052

# Loopback-only development workspace. Keep this disabled on public previews.
BRAIN_LOCAL_DEVELOPMENT=false
# Defaults to web/.data/brain.json. Point at a separate file for each workspace.
BRAIN_DATA_FILE=
DEPARTMENT_STORE_PATH=
# Optional protected team origin. Use NODE_ENV=production and a separate data directory.
BRAIN_TEAM_ORIGIN=
BRAIN_ACCESS_ISSUER=
BRAIN_ACCESS_AUDIENCE=
BRAIN_TEAM_ROSTER={}
# Configure a private intake repository. Use a token with Contents read/write.
BRAIN_GITHUB_REPOSITORY=
BRAIN_GITHUB_BRANCH=main
BRAIN_GITHUB_FOLDER=businessbrain
# OAuth refresh token for the account authorised to write to the intake folder.
BRAIN_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Optional cited synthesis for deployed releases. Set true after approving model data processing.
BRAIN_MODEL_EGRESS_APPROVED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Configure only an approved deployment. Empty settings retain local operation.
RUNTIME_EGRESS_APPROVED=false
SIM_BASE_URL=
SIM_API_KEY=
SIM_WORKFLOW_MAP={}
LOBU_BASE_URL=
LOBU_API_TOKEN=
LOBU_ORG=
LOBU_AGENT_MAP={}
